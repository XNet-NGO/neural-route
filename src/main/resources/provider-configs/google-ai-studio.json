{
  "id": "google-ai-studio",
  "name": "Google AI Studio (Gemini)",
  "dialect": "OPENAI_COMPAT",
  "baseUrl": "https://generativelanguage.googleapis.com",
  "auth": { "scheme": "X_API_KEY", "apiKey": "${GOOGLE_AI_STUDIO_KEY}", "keyHeader": "x-goog-api-key" },
  "endpoints": {
    "chat": "/v1beta/openai/chat/completions",
    "models": "/v1beta/models",
    "embeddings": "/v1beta/embeddings",
    "batches": "/v1beta/openai/batches",
    "interactions": "/v1beta/openai/interactions"
  },
  "capabilities": { "chat": true, "embeddings": true, "imagesGenerate": true },
  "catalog": { "mode": "AUTO", "path": "/v1beta/models" },
  "streaming": "SSE"
}
